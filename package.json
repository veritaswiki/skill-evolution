{
  "name": "skill-evolution",
  "version": "0.3.1",
  "type": "module",
  "description": "Closed-loop skill self-evolution plugin for DSH: post-turn review, Chinese briefing & mandatory directive fusion, 4-gate safety validation, SHA-256 content-addressed ledger with single-entry rollback, LLM umbrella consolidation, and a Web/Mobile/Remote review workbench.",
  "license": "MIT",
  "author": {
    "name": "veritaswiki",
    "url": "https://github.com/veritaswiki"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veritaswiki/skill-evolution.git"
  },
  "homepage": "https://github.com/veritaswiki/skill-evolution#readme",
  "bugs": {
    "url": "https://github.com/veritaswiki/skill-evolution/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "skill",
    "self-evolution",
    "hermes",
    "curator",
    "procedural-memory",
    "ui"
  ],
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "screenshots.json",
    "assets/screenshots/*.png"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "audit:parity": "node tools/verify-parity.mjs",
    "audit:prompts": "node tools/verify-prompt-fidelity.mjs",
    "sanitize": "node scripts/sanitize-check.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.0.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
